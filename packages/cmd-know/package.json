{
  "name": "@axn-dev/cmd-know",
  "version": "0.1.0",
  "description": "axn-dev know command \u2014 local BM25/vector knowledge index",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills"
  ],
  "axn-dev": {
    "commands": [
      {
        "name": "know",
        "description": "Manage the knowledge index (add, index, find)",
        "flags": [
          "add",
          "index",
          "find",
          "--scope",
          "-s",
          "--corpus",
          "-c",
          "--indexing",
          "-i",
          "--show-toplevel",
          "-n",
          "-q",
          "-C",
          "--help",
          "-h"
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "pnpm build"
  },
  "license": "MIT",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "js-yaml": "^4.1.0",
    "wink-bm25-text-search": "^3.1.2",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0"
  },
  "peerDependencies": {
    "@axn-dev/core": "*"
  },
  "devDependencies": {
    "@axn-dev/core": "workspace:*"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  }
}
