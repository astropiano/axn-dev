{
  "name": "@axn-dev/interactive-ui",
  "version": "0.1.0",
  "description": "axn-dev interactive runs: the stage and control pages and their HTTP API, shared by axn-dev flow --interactive-ui and axn-dev serve",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "themes"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "pnpm build"
  },
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@axn-dev/core": "*"
  },
  "devDependencies": {
    "@axn-dev/core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astropiano/axn-dev.git",
    "directory": "packages/interactive-ui"
  },
  "homepage": "https://github.com/astropiano/axn-dev/tree/main/packages/interactive-ui#readme",
  "bugs": "https://github.com/astropiano/axn-dev/issues"
}
