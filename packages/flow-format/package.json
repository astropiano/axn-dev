{
  "name": "@axn-dev/flow-format",
  "version": "0.1.0",
  "description": "axn-dev flow format \u2014 XML flow parser, types, reports, and manual flow runner",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
