{
  "name": "@axn-dev/cmd-c4model",
  "version": "0.1.0",
  "description": "axn-dev c4model command \u2014 C4 decomposition helpers for AI agents (scan, init, render)",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills"
  ],
  "axn-dev": {
    "commands": [
      {
        "name": "c4model",
